# Copie este arquivo para .env e preencha com suas credenciais do Supabase
# .env NÃO deve ser commitado (já está no .gitignore)

SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Connection string Postgres (no painel: Connect → Session pooler)
# Use SEMPRE a URL do pooler: o host direto db.<ref>.supabase.co só resolve em IPv6
# e falha em rede sem IPv6 ("could not translate host name").
# Substitua [YOUR-PASSWORD] pela senha que você definiu ao criar o projeto
DATABASE_URL=postgresql://postgres.SEU_PROJETO:[YOUR-PASSWORD]@aws-1-SUA_REGIAO.pooler.supabase.com:5432/postgres

# Chave da API do Claude — usada para descrever imagens e para julgar a busca.
# Sem ela o app sobe, mas sem descrição de imagem e sem re-rank.
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: troca o modelo usado na visão e no re-rank. Padrão: claude-opus-5.
# CLAUDE_MODEL=claude-sonnet-5


# ─────────────────────────────────────────────────────────────────────────────
# Integração com o frontend
# ─────────────────────────────────────────────────────────────────────────────

# Chave de assinatura dos cookies de sessão. Em produção defina uma string longa
# e aleatória e NÃO a mude depois — trocar a chave desloga todo mundo.
# Gerar uma:  py -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Pasta servida como frontend (relativa a backend/). Vazio = raiz do projeto,
# que é o protótipo em HTML/JS puro. Quando o front definitivo chegar, aponte
# para a pasta de build dele:
# FRONTEND_DIR=../front/dist

# Origens liberadas no CORS, separadas por vírgula. Se ficar vazio, vale a lista
# padrão embutida (portas comuns de dev: 5000, 5500, 5173, 3000, 4200, 8080).
# Só precisa mexer se o front rodar numa porta ou domínio fora dessa lista.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Tamanho máximo do pool de conexões com o Postgres. O front dispara várias
# chamadas em paralelo ao abrir a home, e cada aba multiplica isso. Aumente se
# vir "connection pool exhausted" no log — respeitando o limite do seu plano.
# DB_POOL_MAX=20

# Segundos que uma requisição espera por uma conexão livre antes de desistir.
# DB_POOL_TIMEOUT=10

# Cookies cross-site. Deixe 0 quando o Flask servir o próprio front (same-origin).
# Ponha 1 quando o front estiver em outro domínio/porta E o backend estiver sob
# HTTPS — isso troca SameSite=Lax por SameSite=None; Secure, sem o qual o browser
# não envia o cookie de sessão e o login não funciona.
# ATENÇÃO: SameSite=None exige HTTPS. Em http:// o browser recusa o cookie.
# CROSS_SITE_COOKIES=0


# ─────────────────────────────────────────────────────────────────────────────
# Testes, carga e CI  (ver docs/TESTING.md)
# Nenhuma destas é obrigatória: a suíte roda sem configurar nada.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres COM pgvector dedicado a testes. Os testes marcados `requires_db`
# criam e apagam linhas — jamais aponte para o banco da aplicação. A suíte
# recusa rodar se esta URL for igual à DATABASE_URL acima.
# Sem ela, esses testes são pulados (o resto da suíte roda normalmente).
#   docker run --rm -p 5433:5432 -e POSTGRES_PASSWORD=teste \
#     -e POSTGRES_DB=searchplus_test pgvector/pgvector:pg16
# SEARCHPLUS_TEST_DATABASE_URL=postgresql://postgres:senha_de_teste@localhost:5433/searchplus_test

# Alvo do teste de carga. O padrão é o mock (5001), que não usa banco nem API
# paga. Apontar para 5000 mede o backend real — e gasta créditos da Anthropic.
# SEARCHPLUS_LOAD_URL=http://127.0.0.1:5001

# Perfil de carga: smoke | load | stress
# SEARCHPLUS_LOAD_PROFILE=smoke

# Credencial usada pelos usuários virtuais. No mock qualquer valor entra; contra
# o backend real, precisa ser uma conta de teste — nunca a sua.
# SEARCHPLUS_LOAD_USER=carga_teste
# SEARCHPLUS_LOAD_PASSWORD=troque_por_uma_conta_de_teste

# Libera carga contra host que não seja localhost. Deixe DESLIGADO: existe para
# tornar o disparo contra um ambiente remoto uma decisão explícita, nunca um
# acidente. Não use contra produção.
# SEARCHPLUS_LOAD_ALLOW_REMOTE=0

# Limites de aceitação da carga. Violar qualquer um encerra com erro.
# SEARCHPLUS_LOAD_MAX_ERROR_RATE=0.01
# SEARCHPLUS_LOAD_MAX_P95_MS=1000
# SEARCHPLUS_LOAD_MAX_P95_IA_MS=5000
