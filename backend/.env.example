# Copie este arquivo para .env e preencha com suas credenciais do Supabase
# .env NÃO deve ser commitado (já está no .gitignore)

SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Connection string Postgres (em Project Settings → Database → Connection string)
# Substitua [YOUR-PASSWORD] pela senha que você definiu ao criar o projeto
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.SEU_PROJETO.supabase.co:5432/postgres

# Chave da API do Claude — usada para descrever imagens e para julgar a busca.
# Sem ela o app sobe, mas sem descrição de imagem e sem re-rank.
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: troca o modelo usado na visão e no re-rank. Padrão: claude-opus-5.
# CLAUDE_MODEL=claude-sonnet-5


# ─────────────────────────────────────────────────────────────────────────────
# Integração com o frontend
# ─────────────────────────────────────────────────────────────────────────────

# Chave de assinatura dos cookies de sessão. Em produção defina uma string longa
# e aleatória e NÃO a mude depois — trocar a chave desloga todo mundo.
# Gerar uma:  py -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Pasta servida como frontend (relativa a backend/). Vazio = raiz do projeto,
# que é o protótipo em HTML/JS puro. Quando o front definitivo chegar, aponte
# para a pasta de build dele:
# FRONTEND_DIR=../front/dist

# Origens liberadas no CORS, separadas por vírgula. Se ficar vazio, vale a lista
# padrão embutida (portas comuns de dev: 5000, 5500, 5173, 3000, 4200, 8080).
# Só precisa mexer se o front rodar numa porta ou domínio fora dessa lista.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Tamanho máximo do pool de conexões com o Postgres. O front dispara várias
# chamadas em paralelo ao abrir a home, e cada aba multiplica isso. Aumente se
# vir "connection pool exhausted" no log — respeitando o limite do seu plano.
# DB_POOL_MAX=20

# Segundos que uma requisição espera por uma conexão livre antes de desistir.
# DB_POOL_TIMEOUT=10

# Cookies cross-site. Deixe 0 quando o Flask servir o próprio front (same-origin).
# Ponha 1 quando o front estiver em outro domínio/porta E o backend estiver sob
# HTTPS — isso troca SameSite=Lax por SameSite=None; Secure, sem o qual o browser
# não envia o cookie de sessão e o login não funciona.
# ATENÇÃO: SameSite=None exige HTTPS. Em http:// o browser recusa o cookie.
# CROSS_SITE_COOKIES=0
