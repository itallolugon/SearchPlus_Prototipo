# Copie este arquivo para .env e preencha com suas credenciais do Supabase
# .env NÃO deve ser commitado (já está no .gitignore)

SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Connection string Postgres (no painel: Connect → Session pooler)
# Use SEMPRE a URL do pooler: o host direto db.<ref>.supabase.co só resolve em IPv6
# e falha em rede sem IPv6 ("could not translate host name").
# Substitua [YOUR-PASSWORD] pela senha que você definiu ao criar o projeto
DATABASE_URL=postgresql://postgres.SEU_PROJETO:[YOUR-PASSWORD]@aws-1-SUA_REGIAO.pooler.supabase.com:5432/postgres
