@startuml DER_SearchPlus
' Diagrama Entidade-Relacionamento — Search+
' Banco: PostgreSQL hospedado no Supabase (com extensão pgvector)
' Renderize em: https://www.plantuml.com/plantuml
hide circle
skinparam linetype ortho

entity "users" as users {
  * id : SERIAL <<PK>>
  --
  * username : TEXT <<UNIQUE>>
  * password_hash : TEXT
  config_json : JSONB
}

entity "folders" as folders {
  * id : SERIAL <<PK>>
  --
  * user_id : INTEGER <<FK>>
  * path : TEXT
  * name : TEXT
  added_at : TIMESTAMPTZ
  prioridades : JSONB
  perfil_analise : TEXT
  janela_processamento : TEXT
  --
  UNIQUE (user_id, path)
}

entity "files" as files {
  * id : SERIAL <<PK>>
  --
  folder_id : INTEGER <<FK>>
  * user_id : INTEGER <<FK>>
  * nome : TEXT
  * caminho : TEXT
  * tipo : TEXT
  descricao_ia : TEXT
  embedding : vector(384)
  embedding_clip : vector(512)
  data_adicionado : TIMESTAMPTZ
  favorito : INTEGER
  processado : INTEGER
  --
  UNIQUE (user_id, caminho)
}

entity "collections" as collections {
  * id : SERIAL <<PK>>
  --
  * user_id : INTEGER <<FK>>
  * nome : TEXT
  criado_em : TIMESTAMPTZ
  --
  UNIQUE (user_id, nome)
}

entity "collection_files" as cf {
  * collection_id : INTEGER <<PK,FK>>
  * file_id : INTEGER <<PK,FK>>
  --
  adicionado_em : TIMESTAMPTZ
}

' Relacionamentos (cardinalidade)
entity "collection_folders" as colfolders {
  *id : SERIAL <<PK>>
  --
  *collection_id : INTEGER <<FK>>
  *user_id : INTEGER <<FK>>
  *caminho : TEXT
  criado_em : TIMESTAMPTZ
  --
  UNIQUE (collection_id, caminho)
}

entity "exportacoes" as exportacoes {
  *id : SERIAL <<PK>>
  --
  *user_id : INTEGER <<FK>>
  collection_id : INTEGER <<FK>>
  *colecao : TEXT
  *pasta : TEXT
  total : INTEGER
  copiados : INTEGER
  falhas : JSONB
  estado : TEXT
  quando : TIMESTAMPTZ
}

entity "lixeira" as lixeira {
  *id : SERIAL <<PK>>
  --
  *user_id : INTEGER <<FK>>
  *tipo : TEXT
  *rotulo : TEXT
  *conteudo : JSONB
  excluido_em : TIMESTAMPTZ
}

entity "resumos_indexacao" as resumos {
  *id : SERIAL <<PK>>
  --
  *user_id : INTEGER <<FK>>
  *inicio : TIMESTAMPTZ
  *fim : TIMESTAMPTZ
  *conteudo : JSONB
}

users ||--o{ folders       : "1:N  (ON DELETE CASCADE)"
users ||--o{ files         : "1:N  (ON DELETE CASCADE)"
users ||--o{ collections   : "1:N  (ON DELETE CASCADE)"
folders ||--o{ files       : "1:N  (ON DELETE SET NULL)"
collections ||--o{ cf      : "1:N  (ON DELETE CASCADE)"
files ||--o{ cf            : "1:N  (ON DELETE CASCADE)"
users ||--o{ colfolders    : "1:N  (ON DELETE CASCADE)"
collections ||--o{ colfolders : "1:N  (ON DELETE CASCADE)"
users ||--o{ exportacoes   : "1:N  (ON DELETE CASCADE)"
collections ||--o{ exportacoes : "1:N  (ON DELETE SET NULL)"
users ||--o{ lixeira       : "1:N  (ON DELETE CASCADE)"
users ||--o{ resumos       : "1:N  (ON DELETE CASCADE)"

note bottom of cf
  Tabela associativa (N:N) entre
  collections e files: um arquivo pode
  estar em várias coleções e vice-versa.
end note

note bottom of lixeira
  O que o usuário exclui (coleção ou
  itens dela) fica aqui por um prazo,
  em JSONB, e pode ser restaurado.
end note

note right of files
  embedding / embedding_clip usam a
  extensão pgvector (busca por
  similaridade com índice HNSW).
end note

@enduml
